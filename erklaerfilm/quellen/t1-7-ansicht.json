{
  "id": "1-7-ansicht",
  "teil": "Teil 1 · So findest du dich zurecht",
  "kapitel": "Einfach oder erweitert?",
  "kapKurz": "Einfach oder erweitert?", "kap1": "Einfach oder erweitert?", "kap2": "zwei Ansichten – du entscheidest", "naechstes": "Hilfe – du bist nicht allein",
  "ansicht": "einfach",
  "schritte": ["Die einfache Ansicht", "Umschalten", "Die erweiterte Ansicht", "Register wechseln", "Wieder zurück"],
  "szenen": [
    { "id": "titel", "art": "tafel", "vor": 3.0, "stimme": "thorsten",
      "text": "Einfach oder erweitert? Die App gibt es in zwei Ansichten. Ich zeige dir, wie du umschaltest – und wieder zurück." },
    { "id": "einfach", "schritt": 0, "stimme": "thorsten",
      "text": "Am Anfang siehst du die einfache Ansicht: große Kacheln, nur das Wichtigste. Du erkennst sie an dem grünen Schriftzug: Einfache Ansicht.",
      "tun": [{ "bei": "große Kacheln", "zu": "#v-start .kachel[data-id=termine]", "puls": "#v-start .kachel[data-id=termine]" }, { "bei": "Wichtigste", "puls": "#v-start .kachel[data-id=kommunikation]" },
              { "bei": "grünen Schriftzug", "zeig": ".ansichtname.ein", "puls": ".ansichtname.ein" }] },
    { "id": "umschalten", "schritt": 1, "stimme": "thorsten",
      "text": "Möchtest du alle Funktionen sehen? Ganz unten auf der Startseite steht der Knopf Erweiterte Ansicht. Tippe ihn an.",
      "tun": [{ "bei": "Ganz unten", "zu": "#ansichtKnopf" }, { "bei": "Knopf", "puls": "#ansichtKnopf", "zeig": "#ansichtKnopf" }, { "bei": "Tippe", "tipp": "#ansichtKnopf" }] },
    { "id": "erweitert", "schritt": 2, "stimme": "thorsten",
      "text": "Das ist die erweiterte Ansicht. Hier siehst du alle Funktionen. Oben stehen Register: Club, Meins und Technik.",
      "tun": [{ "bei": 0.2, "weg": true }, { "bei": 0.3, "zu": "#register" }, { "bei": "Register", "puls": "#register" },
              { "bei": "Club,", "zeig": "#register [data-r=verein]" }, { "bei": "Meins", "zeig": "#register [data-r=mein]" }, { "bei": "Technik", "zeig": "#register [data-r=programme]" }] },
    { "id": "register", "schritt": 2, "stimme": "thorsten",
      "text": "Unter Club steht alles rund um den Verein. Unter Meins deine eigenen Sachen, zum Beispiel deine Dokumente. Und unter Technik Programme und Hilfe.",
      "tun": [{ "bei": "Club", "puls": "#register [data-r=verein]" }, { "bei": "Meins", "puls": "#register [data-r=mein]" }, { "bei": "Technik", "puls": "#register [data-r=programme]" }, { "bei": "Hilfe", "weg": true }] },
    { "id": "wischen", "schritt": 3, "stimme": "thorsten",
      "text": "Zum nächsten Register wischst du mit dem Finger über die Kacheln nach links. Schon bist du bei Meins.",
      "tun": [{ "bei": 0, "weg": true }, { "bei": "wischst", "wisch": { "sel": "#raster .kachel >> nth=0", "dx": -220 } }, { "js": "registerWischen(1)" }, { "bei": "Schon", "puls": "#register button.an" }] },
    { "id": "antippen", "schritt": 3, "stimme": "thorsten",
      "text": "Oder du tippst das Register oben direkt an – zum Beispiel wieder Club.",
      "tun": [{ "bei": "wieder Club", "tipp": "#register [data-r=verein]" }] },
    { "id": "zurueck", "schritt": 4, "stimme": "thorsten",
      "text": "Und zurück? Über den Kacheln steht jetzt in roter Schrift: Erweiterte Ansicht. Tippe darauf – schon ist die einfache Ansicht wieder da.",
      "tun": [{ "bei": "Über den Kacheln", "zu": ".ansichtname.erw" }, { "bei": "roter Schrift", "zeig": ".ansichtname.erw", "puls": ".ansichtname.erw" }, { "bei": "Tippe darauf", "tipp": ".ansichtname.erw" }, { "bei": "wieder da", "weg": true }] },
    { "id": "mehr", "schritt": 4, "stimme": "thorsten",
      "text": "Umschalten geht übrigens auch unten unter Mehr, im Bereich Das Wichtigste. Dort steht derselbe Knopf.",
      "tun": [{ "bei": "Mehr", "tipp": "#fuss [data-v=einstellungen]" }, { "bei": "Das Wichtigste", "tipp": ".eu-zeile:has-text(\"Das Wichtigste\")" },
              { "zu": "#v-einstellungen button[onclick=\"ansichtSetzen('erweitert')\"]" }, { "warte": 0.8 }, { "bei": "derselbe Knopf", "zeig": "#v-einstellungen button[onclick=\"ansichtSetzen('erweitert')\"]", "puls": "#v-einstellungen button[onclick=\"ansichtSetzen('erweitert')\"]" }] },
    { "id": "merke", "art": "merke", "stimme": "sprecherin", "nach": 1.5,
      "text": "Merke: Du kannst jederzeit umschalten – kaputt gehen kann dabei nichts." },
    { "id": "ende", "stimme": "thorsten", "nach": 4.0, "endtafel": true,
      "text": "Fertig! Du bist wieder in der einfachen Ansicht. Im nächsten Kapitel zeige ich dir, wo du Hilfe findest, wenn du mal nicht weiterweißt.",
      "tun": [{ "bei": 0.3, "tipp": "#fuss [data-v=start]" }, { "bei": "einfachen Ansicht", "weg": true }] }
  ]
}
