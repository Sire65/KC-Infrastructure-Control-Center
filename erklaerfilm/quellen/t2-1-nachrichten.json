{
  "id": "2-1-nachrichten",
  "teil": "Teil 2 · Die Funktionen im Einzelnen",
  "kapitel": "Nachrichten – lesen, antworten, schreiben",
  "kapKurz": "Nachrichten", "kap1": "Nachrichten", "kap2": "lesen, antworten, schreiben", "naechstes": "Termine & Zusagen",
  "ansicht": "einfach",
  "schritte": ["Nachrichten öffnen", "Chat lesen", "Antworten", "Die Haken", "Foto & Sprache", "Neue Nachricht", "An eine Gruppe"],
  "szenen": [
    { "id": "titel", "art": "tafel", "vor": 3.0, "stimme": "thorsten",
      "text": "Nachrichten. In diesem Kapitel zeige ich dir, wie du Nachrichten liest, beantwortest und neue schreibst." },
    { "id": "wo", "schritt": 0, "stimme": "thorsten",
      "text": "Deine Nachrichten findest du unten in der Leiste. Die rote Zahl zeigt: Zwei Nachrichten sind neu. Tippe auf Nachrichten.",
      "tun": [{ "bei": "unten in der Leiste", "puls": "#fuss [data-v=nachrichten]" }, { "bei": "Die rote Zahl", "zeig": "#fussZaehler" }, { "bei": "Tippe", "tipp": "#fuss [data-v=nachrichten]" }] },
    { "id": "liste", "schritt": 0, "stimme": "thorsten",
      "text": "Hier stehen alle deine Unterhaltungen – die neueste oben. Neue sind umrandet, und der orange Rahmen heißt: wichtig.",
      "tun": [{ "bei": "alle deine Unterhaltungen", "weg": true }, { "bei": "Neue sind umrandet", "puls": ".unterh:has-text(\"Küchenteam\")" }, { "bei": "der orange Rahmen", "zeig": ".unterh:has-text(\"Erika\")", "puls": ".unterh:has-text(\"Erika\")" }] },
    { "id": "oeffnen", "schritt": 1, "stimme": "thorsten",
      "text": "Tippe eine Unterhaltung an, zum Beispiel die mit Erika. Ihre Nachrichten stehen links, deine stehen rechts in Rot.",
      "tun": [{ "bei": "Tippe", "tipp": ".unterh:has-text(\"Erika\")" }, { "bei": "Ihre Nachrichten", "weg": true }, { "bei": "links", "puls": "#msg-M6" }, { "bei": "deine stehen", "puls": "#msg-M5" }] },
    { "id": "antworten", "schritt": 2, "stimme": "thorsten",
      "text": "Erika fragt nach deinem Apfelkuchen. Wir antworten ihr: Tippe unten in das weiße Feld und schreibe deine Antwort.",
      "tun": [{ "bei": "Erika fragt", "puls": "#msg-M6" }, { "bei": "Tippe unten", "schreib": { "sel": "#text", "text": "Ja, gern! Ich backe am Freitag." } }] },
    { "id": "senden", "schritt": 2, "stimme": "thorsten",
      "text": "Mit dem roten Pfeil schickst du sie ab. Und schon steht deine Antwort im Chat.",
      "tun": [{ "bei": "roten Pfeil", "tipp": "#sendenKnopf" }, { "bei": "Und schon", "weg": true }] },
    { "id": "haken", "schritt": 3, "stimme": "thorsten",
      "text": "Die Haken an deinen Nachrichten verraten dir mehr: Ein grauer Haken heißt gesendet. Zwei graue Haken: auf Erikas Handy angekommen. Und zwei blaue Haken: Erika hat sie gelesen.",
      "tun": [{ "bei": "Die Haken", "zu": "#msg-M4" }, { "bei": "Ein grauer Haken", "zeig": "#msg-M5 .haken", "puls": "#msg-M5 .haken" }, { "bei": "Zwei graue", "zeig": "#msg-M4 .haken", "puls": "#msg-M4 .haken" }, { "bei": "zwei blaue", "zeig": "#msg-M2 .haken", "puls": "#msg-M2 .haken" }, { "bei": "gelesen", "weg": true }] },
    { "id": "anlage", "schritt": 4, "stimme": "thorsten",
      "text": "Du möchtest ein Foto schicken? Dann tippe unten auf die Büroklammer. Hier wählst du die Kamera oder ein Bild aus der Galerie.",
      "tun": [{ "bei": "Büroklammer", "tipp": "#eingabe [title=Anlage]" }, { "bei": "die Kamera", "puls": "#anlageBlatt button:has-text(\"Kamera\")" }, { "bei": "Bild aus der Galerie", "puls": "#anlageBlatt button:has-text(\"Galerie\")" }] },
    { "id": "abbrechen", "schritt": 4, "stimme": "thorsten",
      "text": "Heute schicken wir kein Foto – also tippen wir auf Abbrechen.",
      "tun": [{ "bei": "Abbrechen", "tipp": "#anlageBlatt button:has-text(\"Abbrechen\")" }] },
    { "id": "mikro", "schritt": 4, "stimme": "thorsten",
      "text": "Lieber sprechen als tippen? Mit dem Mikrofon nimmst du eine Sprachnachricht auf. Einfach antippen und los sprechen.",
      "tun": [{ "bei": "Mikrofon", "zeig": "#mikroKnopf", "puls": "#mikroKnopf" }, { "bei": "los sprechen", "weg": true }] },
    { "id": "zurueck", "schritt": 5, "stimme": "thorsten",
      "text": "Zurück zur Übersicht kommst du oben links mit dem Pfeil.",
      "tun": [{ "bei": "oben links", "tipp": "#v-chat .zurueck, #chatKopf .zurueck" }] },
    { "id": "neu", "schritt": 5, "stimme": "thorsten",
      "text": "Eine neue Nachricht beginnst du oben rechts mit Plus Neu.",
      "tun": [{ "bei": "Plus Neu", "tipp": "#v-nachrichten .kopf2 .knopf.haupt" }] },
    { "id": "anwen", "schritt": 5, "stimme": "thorsten",
      "text": "Jetzt wählst du, an wen sie geht. Suche einen Namen, zum Beispiel Otto, und setze den Haken.",
      "tun": [{ "bei": "Suche", "schreib": { "sel": "#empfSuche", "text": "Otto" } }, { "bei": "setze den Haken", "tipp": "#v-neu input[onchange*=P5]" }] },
    { "id": "weiter", "schritt": 5, "stimme": "thorsten",
      "text": "Dann tippst du auf Weiter zum Schreiben. Du schreibst wie gewohnt – und sendest mit dem roten Pfeil.",
      "tun": [{ "bei": "Weiter zum Schreiben", "tipp": "#v-neu button:has-text(\"Weiter zum Schreiben\")" }, { "bei": "Du schreibst", "schreib": { "sel": "#text", "text": "Hallo Otto, kommst du Samstag?" } }, { "tipp": "#sendenKnopf" }, { "weg": true }] },
    { "id": "gruppe", "schritt": 6, "stimme": "thorsten",
      "text": "Und an eine ganze Gruppe? Unten auf Nachrichten, wieder auf Plus Neu – ganz oben stehen deine Gruppen. Ein Tipp aufs Küchenteam, und du schreibst direkt in die Gruppe.",
      "tun": [{ "bei": "Unten auf Nachrichten", "tipp": "#fuss [data-v=nachrichten]" }, { "bei": "wieder auf Plus Neu", "tipp": "#v-nachrichten .kopf2 .knopf.haupt" }, { "bei": "deine Gruppen", "puls": "#neuGruppen" }, { "bei": "Ein Tipp", "tipp": "#neuGruppen button:has-text(\"Küchenteam\")" }, { "bei": "direkt in die Gruppe", "weg": true }] },
    { "id": "merke", "art": "merke", "stimme": "sprecherin", "nach": 1.5,
      "text": "Merke: Antippen, schreiben – und mit dem roten Pfeil senden." },
    { "id": "ende", "stimme": "thorsten", "nach": 4.0, "endtafel": true,
      "text": "Fertig! Jetzt kannst du Nachrichten lesen, beantworten und neue schreiben. Im nächsten Kapitel geht es um Termine und Zusagen.",
      "tun": [{ "bei": 0.3, "tipp": "#fuss [data-v=start]" }, { "bei": "Jetzt kannst du", "weg": true }] }
  ]
}
