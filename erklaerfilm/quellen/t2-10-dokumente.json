{
  "id": "2-10-dokumente",
  "teil": "Teil 2 · Die Funktionen im Einzelnen",
  "kapitel": "Dokumente, Protokolle & meine Daten",
  "kapKurz": "Dokumente & Daten", "kap1": "Dokumente & Daten", "kap2": "nachlesen, finden, Änderungen melden", "naechstes": "Mitmachen",
  "ansicht": "erweitert",
  "schritte": ["Protokolle", "Filter", "Protokoll lesen", "Meine Dokumente", "Meine Daten", "Änderung melden"],
  "szenen": [
    { "id": "titel", "art": "tafel", "vor": 3.0, "stimme": "thorsten",
      "text": "Dokumente, Protokolle und deine Daten. In diesem Kapitel liest du ein Protokoll nach, findest deine Anleitungen und siehst, was der Club über dich gespeichert hat." },
    { "id": "wo", "schritt": 0, "stimme": "thorsten",
      "text": "Diese Bereiche findest du in der erweiterten Ansicht. Im Register Club liegen die Protokolle. Tippe die Kachel an.",
      "tun": [{ "bei": "Register Club", "zeig": "#register button[data-r=verein]", "puls": "#register button[data-r=verein]" },
              { "bei": "liegen", "zu": "#raster .kachel[data-id=protokolle]", "puls": "#raster .kachel[data-id=protokolle]" },
              { "bei": "Tippe", "tipp": "#raster .kachel[data-id=protokolle]" }] },
    { "id": "liste", "schritt": 0, "stimme": "thorsten",
      "text": "Hier stehen alle Protokolle der Clubsitzungen. Neue sind markiert, bis du sie geöffnet hast. Ein grüner Haken heißt: genehmigt.",
      "tun": [{ "bei": "Neue sind", "zeig": "#protokollListe .prkarte >> nth=0", "puls": "#protokollListe .prkarte >> nth=0" },
              { "bei": "grüner Haken", "zeig": "#protokollListe .prkarte >> nth=1 >> .marke", "puls": "#protokollListe .prkarte >> nth=1" }, { "bei": "genehmigt", "weg": true }] },
    { "id": "filter", "schritt": 1, "stimme": "thorsten",
      "text": "Mit dem Filter oben suchst du nach Jahr, Monat, Ort oder danach, wer geschrieben hat. Zum Beispiel nur die Sitzungen im Vereinsheim.",
      "tun": [{ "bei": "Filter", "tipp": "#prFilterKnopf" }, { "bei": "Zum Beispiel", "zeig": "#prfOrt", "puls": "#prfOrt" },
              { "bei": "im Vereinsheim", "js": "(() => { const s = document.getElementById('prfOrt'); s.value = 'Vereinsheim'; s.dispatchEvent(new Event('change')); })()" }] },
    { "id": "filteraus", "schritt": 1, "stimme": "thorsten",
      "text": "Jetzt sind es nur noch zwei. Mit Alle zeigen ist wieder alles da – und das Kreuz schließt den Filter.",
      "tun": [{ "bei": "nur noch zwei", "zeig": "#prfTreffer", "puls": "#prfTreffer" }, { "bei": "Alle zeigen", "tipp": "#prFilterFeld button:has-text(\"Alle zeigen\")" },
              { "bei": "Kreuz", "tipp": "#prFilterFeld .pr-filter-zu" }] },
    { "id": "oeffnen", "schritt": 2, "stimme": "thorsten",
      "text": "Tippe ein Protokoll an, um es zu lesen. Oben stehen Datum, Ort und wer da war. Darunter die Tagesordnung, die Beschlüsse und eine kurze Zusammenfassung.",
      "tun": [{ "bei": "Tippe", "tipp": "#protokollListe .prkarte >> nth=0" }, { "bei": "Oben stehen", "weg": true }, { "bei": "wer da war", "puls": "#protokollInhalt >> text=Anwesend" },
              { "bei": "Tagesordnung", "zu": "#protokollInhalt >> text=Tagesordnung", "puls": "#protokollInhalt >> text=Tagesordnung" },
              { "bei": "Beschlüsse", "puls": "#protokollInhalt >> text=Beschlüsse" }, { "bei": "Zusammenfassung", "puls": "#protokollInhalt >> text=Kurzfassung" }] },
    { "id": "einwand", "schritt": 2, "stimme": "thorsten",
      "text": "Weiter unten kannst du das Protokoll drucken. Und hast du etwas anders in Erinnerung, erhebst du bis zum angegebenen Tag einen Einwand.",
      "tun": [{ "bei": "Weiter unten", "zu": "#protokollInhalt button:has-text(\"Drucken\")" }, { "bei": "drucken", "zeig": "#protokollInhalt button:has-text(\"Drucken\")", "puls": "#protokollInhalt button:has-text(\"Drucken\")" },
              { "bei": "Erinnerung", "zu": "#protokollInhalt button:has-text(\"Einwand erheben\")" }, { "bei": "Einwand", "zeig": "#protokollInhalt button:has-text(\"Einwand erheben\")", "puls": "#protokollInhalt button:has-text(\"Einwand erheben\")" }] },
    { "id": "zurueck", "schritt": 2, "stimme": "thorsten",
      "text": "Mit dem Pfeil oben links geht es zurück zur Liste.",
      "tun": [{ "bei": "Pfeil", "tipp": "#v-protokoll .zurueck" }] },
    { "id": "dokumente", "schritt": 3, "stimme": "thorsten",
      "text": "Deine Anleitungen findest du auf der Startseite im Register Meins – unter Meine Dokumente.",
      "tun": [{ "bei": "Startseite", "tipp": "#fuss [data-v=start]" }, { "bei": "Meins", "tipp": "#register button[data-r=mein]" }, { "bei": "Meine Dokumente", "tipp": "#raster .kachel[data-id=dokumente]" }] },
    { "id": "dokliste", "schritt": 3, "stimme": "thorsten",
      "text": "Hier liegt zum Beispiel die Bedienungsanleitung der App. Antippen öffnet das Dokument – dort kannst du es auch drucken. Mit dem Pfeil geht es zurück.",
      "tun": [{ "bei": "Bedienungsanleitung", "zeig": "#dokRaster .kachel:has-text(\"Bedienungs\")", "puls": "#dokRaster .kachel:has-text(\"Bedienungs\")" },
              { "bei": "Mit dem Pfeil", "tipp": "#v-dokumente .zurueck" }] },
    { "id": "daten", "schritt": 4, "stimme": "thorsten",
      "text": "Und was ist über dich gespeichert? Das zeigt dir im Register Meins die Kachel Meine Daten.",
      "tun": [{ "bei": "Register Meins", "puls": "#register button[data-r=mein]" }, { "bei": "Kachel", "tipp": "#raster .kachel[data-id=meinedaten]" }] },
    { "id": "datenblatt", "schritt": 4, "stimme": "thorsten",
      "text": "Hier steht alles auf einen Blick: deine Angaben, dein Zugang zur App und deine Einstellungen. Nur du siehst diese Übersicht.",
      "tun": [{ "bei": 0, "weg": true }, { "bei": "deine Angaben", "puls": "#mdatInhalt .ps-schritt >> nth=0" }, { "bei": "dein Zugang", "zu": "#mdatInhalt .ps-schritt >> nth=1", "puls": "#mdatInhalt .ps-schritt >> nth=1" }] },
    { "id": "melden", "schritt": 5, "stimme": "thorsten",
      "text": "Hat sich etwas geändert, zum Beispiel deine Anschrift? Dann tippst du unten auf Änderung melden.",
      "tun": [{ "bei": "Hat sich", "zu": "#mdatInhalt .na-pfeil-knoepfe" }, { "bei": "Änderung melden", "tipp": "#mdatInhalt .na-pfeil-knoepfe .knopf.haupt" }] },
    { "id": "anschrift", "schritt": 5, "stimme": "thorsten",
      "text": "Tippe an, was sich geändert hat – hier die Anschrift. Dann trägst du die neue Straße ein.",
      "tun": [{ "bei": "hier die Anschrift", "tipp": "#aeBlatt button:has-text(\"Neue Anschrift\")" },
              { "bei": "Dann trägst", "js": "(() => { const e = document.getElementById('aeF_strasse'); e.value = ''; })()" },
              { "schreib": { "sel": "#aeF_strasse", "text": "Lindenstraße 5" } }] },
    { "id": "senden", "schritt": 5, "stimme": "thorsten",
      "text": "Mit Änderung melden geht die Meldung an die Richtigen im Club. Darunter siehst du: Sie wird geprüft. Du bekommst Bescheid, sobald sie eingetragen ist.",
      "tun": [{ "bei": "Mit Änderung", "tipp": "#aeBlatt button:has-text(\"Änderung melden\")" }, { "bei": "Darunter", "zu": "#aeBlatt .ae-meine", "puls": "#aeBlatt .ae-meine" }, { "bei": "Bescheid", "weg": true }] },
    { "id": "schliessen", "schritt": 5, "stimme": "thorsten",
      "text": "Mit Schließen bist du wieder auf der Startseite.",
      "tun": [{ "bei": "Schließen", "tipp": "#aeBlatt button:has-text(\"Schließen\")" }] },
    { "id": "merke", "art": "merke", "stimme": "sprecherin", "nach": 1.5,
      "text": "Merke: Protokolle, Anleitungen und deine Daten – alles zum Nachlesen, und nichts geht verloren." },
    { "id": "ende", "stimme": "thorsten", "nach": 4.0, "endtafel": true,
      "text": "Das war das Kapitel Dokumente und Daten. Im nächsten Kapitel zeige ich dir, wie du im Club mitmachen kannst.",
      "tun": [{ "bei": "Kapitel Dokumente", "weg": true }] }
  ]
}
