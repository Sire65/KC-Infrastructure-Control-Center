{
  "id": "1-3-zahlen",
  "teil": "Teil 1 · So findest du dich zurecht",
  "kapitel": "Zahlen auf den Kacheln – was wartet auf mich?",
  "kapKurz": "Zahlen auf den Kacheln", "kap1": "Zahlen auf den Kacheln", "kap2": "was wartet auf mich?", "naechstes": "Die Leiste unten",
  "ansicht": "einfach",
  "schritte": ["Was die Zahl heißt", "Drei Felder im Kopf", "Ansehen", "Zahl ist weg"],
  "szenen": [
    { "id": "titel", "art": "tafel", "vor": 3.0, "stimme": "thorsten",
      "text": "Zahlen auf den Kacheln. Hier erfährst du, was die kleinen Zahlen bedeuten – und wie sie wieder verschwinden." },
    { "id": "zahlen", "schritt": 0, "stimme": "thorsten",
      "text": "Siehst du die kleinen Zahlen auf den Kacheln? Sie zeigen dir, was auf dich wartet. Hier sind es zwei neue Nachrichten und zwei neue Zettel an der Pinnwand.",
      "tun": [{ "bei": "kleinen Zahlen", "zu": "#v-start .kachel[data-id=kommunikation]" }, { "bei": "zwei neue Nachrichten", "zeig": "#v-start .kachel[data-id=kommunikation] .zahl", "puls": "#v-start .kachel[data-id=kommunikation] .zahl" },
              { "bei": "zwei neue Zettel", "zeig": "#v-start .kachel[data-id=pinnwand] .zahl", "puls": "#v-start .kachel[data-id=pinnwand] .zahl" }] },
    { "id": "abstimmung", "schritt": 0, "stimme": "thorsten",
      "text": "Und bei den Vorschlägen wartet eine Abstimmung auf deine Stimme.",
      "tun": [{ "bei": "Vorschlägen", "zu": "#v-start .kachel[data-id=vorschlaege]" }, { "bei": "eine Abstimmung", "zeig": "#v-start .kachel[data-id=vorschlaege] .zahl", "puls": "#v-start .kachel[data-id=vorschlaege] .zahl" }] },
    { "id": "leiste", "schritt": 0, "stimme": "thorsten",
      "text": "Die Zahl der neuen Nachrichten siehst du auch unten in der Leiste.",
      "tun": [{ "bei": "unten in der Leiste", "zeig": "#fussZaehler", "puls": "#fuss [data-v=nachrichten]" }] },
    { "id": "felder", "schritt": 1, "stimme": "thorsten",
      "text": "Oben im Kopf stehen drei kleine Felder: links deine neuen Nachrichten. In der Mitte, wie viele Mitglieder gerade in der App sind. Und rechts wechseln sich Datum, Uhrzeit und die Tage bis zum nächsten Treffen ab.",
      "tun": [{ "bei": "Oben im Kopf", "zu": "#heroInfo" }, { "bei": "links", "zeig": ".kacheln3 .mini >> nth=0", "puls": ".kacheln3 .mini >> nth=0" },
              { "bei": "In der Mitte", "zeig": ".kacheln3 .mini >> nth=1", "puls": ".kacheln3 .mini >> nth=1" }, { "bei": "rechts wechseln", "zeig": ".kacheln3 .mini >> nth=2", "puls": ".kacheln3 .mini >> nth=2" }, { "bei": "nächsten Treffen", "weg": true }] },
    { "id": "oeffnen", "schritt": 2, "stimme": "thorsten",
      "text": "Und so verschwindet eine Zahl: Tippe auf Nachrichten und öffne die neue Nachricht – zum Beispiel die von Erika.",
      "tun": [{ "bei": "Tippe auf Nachrichten", "tipp": "#v-start .kachel[data-id=kommunikation]" }, { "bei": "zum Beispiel", "tipp": ".unterh:has-text(\"Erika\")" }] },
    { "id": "zurueck", "schritt": 2, "stimme": "thorsten", "nach": 0.8,
      "text": "Jetzt tippst du unten auf Start. Schau: Bei Nachrichten steht nur noch eine Eins.",
      "tun": [{ "bei": "unten auf Start", "tipp": "#fuss [data-v=start]" }, { "bei": "Schau", "zu": "#v-start .kachel[data-id=kommunikation]" }, { "bei": "nur noch", "zeig": "#v-start .kachel[data-id=kommunikation] .zahl", "puls": "#v-start .kachel[data-id=kommunikation] .zahl" }] },
    { "id": "zweite", "schritt": 2, "stimme": "thorsten",
      "text": "Die zweite neue Nachricht kam vom Küchenteam. Auch die schauen wir uns an – und dann wieder zurück zum Start.",
      "tun": [{ "bei": "Die zweite", "tipp": "#v-start .kachel[data-id=kommunikation]" }, { "bei": "Auch die", "tipp": ".unterh:has-text(\"Küchenteam\")" }, { "bei": "zurück zum Start", "tipp": "#fuss [data-v=start]" }] },
    { "id": "weg", "schritt": 3, "stimme": "thorsten", "nach": 0.8,
      "text": "Jetzt ist die Zahl bei Nachrichten ganz weg – auch unten in der Leiste. Du hast alles gelesen.",
      "tun": [{ "bei": "Jetzt", "zu": "#v-start .kachel[data-id=kommunikation]" }, { "bei": "ganz weg", "zeig": "#v-start .kachel[data-id=kommunikation]", "puls": "#v-start .kachel[data-id=kommunikation]" }, { "bei": "unten in der Leiste", "zeig": "#fuss [data-v=nachrichten]" }, { "bei": "alles gelesen", "weg": true }] },
    { "id": "merke", "art": "merke", "stimme": "sprecherin", "nach": 1.5,
      "text": "Merke: Eine Zahl auf der Kachel heißt: Hier wartet etwas auf dich." },
    { "id": "ende", "stimme": "thorsten", "nach": 4.0, "endtafel": true,
      "text": "Das war es schon. Im nächsten Kapitel zeige ich dir die Leiste unten – damit kommst du von überall wieder zurück." }
  ]
}
