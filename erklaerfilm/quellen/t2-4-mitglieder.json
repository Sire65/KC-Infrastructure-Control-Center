{
  "id": "2-4-mitglieder",
  "teil": "Teil 2 · Die Funktionen im Einzelnen",
  "kapitel": "Mitglieder & mein Status",
  "kapKurz": "Mitglieder & Status", "kap1": "Mitglieder & Status", "kap2": "wer ist da – und bist du erreichbar?", "naechstes": "Mein Dienst & Wunschdienst",
  "ansicht": "einfach",
  "schritte": ["Mitglieder öffnen", "Wer ist online?", "Schreiben & anklopfen", "Anrufen", "Mein Status", "Wieder verfügbar"],
  "szenen": [
    { "id": "titel", "art": "tafel", "vor": 3.0, "stimme": "thorsten",
      "text": "Mitglieder und dein Status. Hier siehst du, wer zum Club gehört und wer gerade da ist. Und du sagst den anderen, ob du erreichbar bist." },
    { "id": "wo", "schritt": 0, "stimme": "thorsten",
      "text": "Wo finde ich das? Ganz einfach: unten in der Leiste auf Mitglieder.",
      "tun": [{ "bei": "Mitglieder", "tipp": "#fuss [data-v=mitglieder]" }] },
    { "id": "kacheln", "schritt": 1, "stimme": "thorsten",
      "text": "Jede Kachel ist ein Mitglied: mit Name, Amt und Status. Ein grüner Rand und das Wort online heißen: Erika ist gerade in der App.",
      "tun": [{ "bei": "Jede Kachel", "puls": "#v-mitglieder .mg-kachel" }, { "bei": "grüner Rand", "zeig": "#v-mitglieder .mg-kachel.mg-online", "puls": "#v-mitglieder .mg-kachel.mg-online" }, { "bei": "Erika ist", "weg": true }] },
    { "id": "schreiben", "schritt": 2, "stimme": "thorsten",
      "text": "Darunter die Knöpfe. Die Sprechblase schreibt Erika eine Nachricht. Tippst du darauf, bist du gleich im Gespräch mit ihr.",
      "tun": [{ "bei": "Sprechblase", "zeig": "[onclick=\"direkt('P2')\"]", "puls": "[onclick=\"direkt('P2')\"]" }, { "bei": "Tippst du", "tipp": "[onclick=\"direkt('P2')\"]" }, { "bei": "gleich im", "weg": true }] },
    { "id": "zurueck", "schritt": 2, "stimme": "thorsten",
      "text": "Zurück zu den Mitgliedern kommst du mit dem Pfeil oben links.",
      "tun": [{ "bei": "Pfeil", "tipp": ".zurueck[onclick*=nachrichten]" }, { "bei": "oben links", "weg": true }] },
    { "id": "anklopfen", "schritt": 2, "stimme": "thorsten",
      "text": "Die winkende Hand klopft bei Erika an. Dann weiß sie: Du möchtest kurz etwas von ihr.",
      "tun": [{ "bei": "winkende Hand", "zeig": "[onclick=\"anklopfen('P2')\"]", "puls": "[onclick=\"anklopfen('P2')\"]" }, { "bei": "Dann weiß", "weg": true }] },
    { "id": "anrufen", "schritt": 3, "stimme": "thorsten",
      "text": "Der Hörer ruft Erika über die App an, die Kamera sogar mit Bild. Das geht, wenn ihr beide gerade online seid.",
      "tun": [{ "bei": "Hörer", "zeig": "[onclick=\"anrufen('P2')\"]", "puls": "[onclick=\"anrufen('P2')\"]" }, { "bei": "Kamera", "zeig": "[onclick=\"anrufen('P2', true)\"]", "puls": "[onclick=\"anrufen('P2', true)\"]" }, { "bei": "Das geht", "weg": true }] },
    { "id": "blass", "schritt": 3, "stimme": "thorsten",
      "text": "Bei Paul sind die Knöpfe blass. Er ist gerade nicht in der App. Schreib ihm dann lieber eine Nachricht.",
      "tun": [{ "bei": 0, "zu": ".mg-kachel:has-text(\"Paul Probe\")" }, { "bei": "Knöpfe blass", "zeig": ".mg-kachel:has-text(\"Paul Probe\") [title=Anrufen]", "puls": ".mg-kachel:has-text(\"Paul Probe\") .mg-knoepfe" }, { "bei": "Schreib ihm", "zeig": "[onclick=\"direkt('P3')\"]" }, { "bei": "Nachricht.", "weg": true }] },
    { "id": "status", "schritt": 4, "stimme": "thorsten",
      "text": "Jetzt zu dir. Oben rechts steht dein Status. Tippe auf Mein Status.",
      "tun": [{ "bei": 0, "zu": "#meinStatusKnopf" }, { "bei": "Oben rechts", "puls": "#meinStatusKnopf" }, { "bei": "Tippe", "tipp": "#meinStatusKnopf" }] },
    { "id": "urlaub", "schritt": 4, "stimme": "thorsten",
      "text": "Wähle, was gerade passt: verfügbar, beschäftigt, im Urlaub, krank oder nicht erreichbar. Wir nehmen: im Urlaub.",
      "tun": [{ "bei": "verfügbar", "puls": "#statusBlatt .liste" }, { "bei": "Wir nehmen", "tipp": "#statusBlatt button:has-text(\"im Urlaub\")" }] },
    { "id": "hinweis", "schritt": 4, "stimme": "thorsten",
      "text": "Wenn du magst, schreibst du noch einen kurzen Hinweis dazu. Zum Beispiel: Bis Sonntag, ab Montag wieder da.",
      "tun": [{ "bei": "kurzen Hinweis", "schreib": { "sel": "#stHinweis", "text": "Bis Sonntag, ab Montag wieder da" } }] },
    { "id": "speichern", "schritt": 4, "stimme": "thorsten",
      "text": "Dann auf Speichern. Fertig! Die anderen sehen jetzt bei deinem Namen: im Urlaub – mit deinem Hinweis.",
      "tun": [{ "bei": "Speichern", "tipp": "#statusBlatt [onclick=\"statusSpeichern()\"]" }, { "bei": "Die anderen", "zeig": ".mg-kachel:has-text(\"Max Mustermann\") .stmarke, .mg-kachel:has-text(\"Max Mustermann\")", "puls": ".mg-kachel:has-text(\"Max Mustermann\")" }, { "bei": "Hinweis.", "weg": true }] },
    { "id": "wieder", "schritt": 5, "stimme": "thorsten",
      "text": "Bist du wieder da? Dann tippst du auf Mein Status, wählst verfügbar – und speicherst.",
      "tun": [{ "bei": "Dann tippst", "tipp": "#meinStatusKnopf" }, { "bei": "wählst", "tipp": "#statusBlatt button:has-text(\"verfügbar\")" }, { "bei": "speicherst", "tipp": "#statusBlatt [onclick=\"statusSpeichern()\"]" }, { "weg": true }] },
    { "id": "merke", "art": "merke", "stimme": "sprecherin", "nach": 1.5,
      "text": "Merke: Grün heißt gerade da. Und dein Status sagt den anderen, ob du erreichbar bist." },
    { "id": "ende", "stimme": "thorsten", "nach": 4.0, "endtafel": true,
      "text": "Gut gemacht! Im nächsten Kapitel geht es um deinen Dienst – und um deine Wünsche für den Weihnachtsmarkt.",
      "tun": [{ "bei": 0.3, "tipp": "#fuss [data-v=start]" }, { "bei": "nächsten", "weg": true }] }
  ]
}
